# ─────────────────────────────────────────────────────────────
# SIGNUM · Variables de entorno
# Copie este archivo como  .env  y ajuste los valores.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Cadena de conexión a PostgreSQL.
# Local con Docker (docker compose up -d db):
DATABASE_URL=postgresql://signum:signum@127.0.0.1:5432/signum

# Local con PostgreSQL instalado en la máquina:
# DATABASE_URL=postgresql://postgres:TU_CLAVE@127.0.0.1:5432/signum

# Proveedores en la nube (Neon, Supabase, Railway…): requieren SSL
# DATABASE_URL=postgresql://usuario:clave@host.neon.tech/signum?sslmode=require

# URL pública de la aplicación. Se usa para construir los enlaces de firma
# que se comparten con los destinatarios.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clave para firmar las cookies de sesión.
# EN PRODUCCIÓN genere una propia:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=cambie-esta-clave-por-una-aleatoria-de-al-menos-48-caracteres

# Clave maestra que cifra las claves privadas Ed25519 de los firmantes (AES-256-GCM).
# Genere una propia y NO la pierda: sin ella no se puede volver a firmar con las llaves existentes.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SIGNING_MASTER_KEY=cambie-esta-clave-maestra-por-una-aleatoria-de-48-caracteres

# Entrega del código de intención (OTP): demo = se muestra en pantalla · email = se envía por correo
OTP_DELIVERY=demo

# Inicialización automática: crea/actualiza tablas al arrancar sin borrar datos.
AUTO_BOOTSTRAP_DB=true

# Contraseña inicial para admin y Carlos SOLO cuando aún no existen.
# Cámbiela obligatoriamente antes de desplegar en un dominio real.
BOOTSTRAP_ADMIN_PASSWORD=admin

# Entorno de ejecución (development | production)
NODE_ENV=development
